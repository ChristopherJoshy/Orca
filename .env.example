# Local only. Change DATABASE_URL for your PostgreSQL installation.
ORCA_ADDR=127.0.0.1:8080
ORCA_ENV=development
ORCA_BILLING_INTERVAL=1m
ORCA_EMAIL_INTERVAL=1m
DATABASE_URL='postgresql://orca@localhost/orca?host=/tmp&port=54329&sslmode=disable'
ORCA_COOKIE_SECURE=false
ORCA_ALLOWED_ORIGIN=http://localhost:5173
# Local Vite proxy target; keep API traffic same-origin in the browser.
ORCA_API_TARGET=http://127.0.0.1:8080
# Local private directory for generated export archives.
ORCA_EXPORT_DIR=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
STRIPE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
RESEND_API_KEY=
EMAIL_FROM='ORCA <noreply@example.com>'
ORCA_PUBLIC_URL=http://localhost:5173
