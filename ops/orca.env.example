# Copy to /etc/orca/orca.env on the VPS and set real values there.
# This file is a template only. Never add production secrets to Git or Vercel.
ORCA_ADDR=127.0.0.1:8081
ORCA_ENV=production
ORCA_BILLING_INTERVAL=1m
ORCA_EMAIL_INTERVAL=1m
DATABASE_URL=postgresql://orca:<password>@<postgres-host>:5432/orca?sslmode=require
ORCA_COOKIE_SECURE=true
ORCA_ALLOWED_ORIGIN=https://<vercel-production-domain>
ORCA_PUBLIC_URL=https://<vercel-production-domain>
ORCA_EXPORT_DIR=/var/lib/orca/exports
EMAIL_FROM=ORCA <verified-sender@example.com>
RESEND_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
