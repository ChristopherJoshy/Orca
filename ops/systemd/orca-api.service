[Unit]
Description=ORCA subscription billing API and recurring worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=orca
Group=orca
WorkingDirectory=/opt/orca/backend
EnvironmentFile=/etc/orca/orca.env
ExecStart=/opt/orca/bin/orca-api
Restart=on-failure
RestartSec=5s
TimeoutStopSec=25s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=orca
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
